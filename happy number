#include <stdio.h>
#include <stdbool.h>

// Helper function to calculate the sum of the squares of digits
int getNext(int n) {
    int sum = 0;
    while (n > 0) {
        int digit = n % 10;
        sum += digit * digit;
        n /= 10;
    }
    return sum;
}

// Function to check if a number is a happy number
bool isHappy(int n) {
    int tortoise = n;
    int hare = getNext(n);
    
    // Move tortoise and hare until they meet or hare reaches 1
    while (hare != 1 && tortoise != hare) {
        tortoise = getNext(tortoise);         // Move 1 step
        hare = getNext(getNext(hare));       // Move 2 steps
    }
    
    // If hare reached 1, it's a happy number
    return hare == 1;
}
