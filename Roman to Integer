#include <stdio.h>
#include <string.h>

// Helper function to return the value of a single Roman numeral character
int romanValue(char c) {
    switch (c) {
        case 'I': return 1;
        case 'V': return 5;
        case 'X': return 10;
        case 'L': return 50;
        case 'C': return 100;
        case 'D': return 500;
        case 'M': return 1000;
        default:  return 0;
    }
}

// Function to convert Roman numeral string to an integer
int romanToInt(char *s) {
    int total = 0;
    int length = strlen(s);

    for (int i = 0; i < length; i++) {
        int currentVal = romanValue(s[i]);

        // If the current symbol is smaller than the next symbol, subtract it
        if (i + 1 < length && currentVal < romanValue(s[i + 1])) {
            total -= currentVal;
        } else {
            // Otherwise, add it to the total
            total += currentVal;
        }
    }

    return total;
}
