#include <stdbool.h>

bool isPalindrome(int x) {
    // Negative numbers are not palindromes (e.g., -121 reads as 121-)
    // Numbers ending in 0 are not palindromes (except 0 itself)
    if (x < 0 || (x % 10 == 0 && x != 0)) {
        return false;
    }

    int reversedHalf = 0;
    
    // Reverse only the second half of the number to avoid integer overflow
    while (x > reversedHalf) {
        reversedHalf = (reversedHalf * 10) + (x % 10);
        x /= 10;
    }

    // For even length: x == reversedHalf
    // For odd length: x == reversedHalf / 10 (gets rid of the middle digit)
    return x == reversedHalf || x == reversedHalf / 10;
}
