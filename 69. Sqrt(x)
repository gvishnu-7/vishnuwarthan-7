#include <stdio.h>

int mySqrt(int x) {
    if (x == 0 || x == 1) {
        return x;
    }
    
    int left = 1;
    int right = x;
    int ans = 0;
    
    while (left <= right) {
        int mid = left + (right - left) / 2;
        
        // Use division (x / mid) instead of multiplication (mid * mid) 
        // to completely prevent integer overflow.
        if (mid <= x / mid) {
            ans = mid;     // mid could be the potential answer
            left = mid + 1; // Try to look for a larger integer
        } else {
            right = mid - 1; // mid is too large, look in the lower half
        }
    }
    
    return ans;
}
