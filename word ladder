#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdbool.h>

// Helper function to check if two words differ by exactly one character
bool isAdjacent(const char* word1, const char* word2, int len) {
    int diffCount = 0;
    for (int i = 0; i < len; i++) {
        if (word1[i] != word2[i]) {
            diffCount++;
            if (diffCount > 1) return false;
        }
    }
    return diffCount == 1;
}

int ladderLength(char* beginWord, char* endWord, char** wordList, int wordListSize) {
    int wordLen = strlen(beginWord);
    
    // Step 1: Find if endWord exists in wordList
    int endIndex = -1;
    for (int i = 0; i < wordListSize; i++) {
        if (strcmp(wordList[i], endWord) == 0) {
            endIndex = i;
            break;
        }
    }
    // If endWord is not in the dictionary, no transformation is possible
    if (endIndex == -1) return 0;

    // Step 2: Initialize BFS structures
    // Queue stores pairs of (wordList_index, current_path_length)
    // We allocate size up to wordListSize + 1 to handle the beginWord
    int* queueIdx = (int*)malloc((wordListSize + 1) * sizeof(int));
    int* queueDist = (int*)malloc((wordListSize + 1) * sizeof(int));
    bool* visited = (bool*)calloc(wordListSize, sizeof(bool));
    
    int head = 0, tail = 0;
    
    // Push the beginWord into the queue (represented by index -1)
    queueIdx[tail] = -1; 
    queueDist[tail] = 1; // Path starts with length 1
    tail++;
    
    // Step 3: BFS Loop
    while (head < tail) {
        int currIdx = queueIdx[head];
        int currDist = queueDist[head];
        head++;
        
        char* currWord = (currIdx == -1) ? beginWord : wordList[currIdx];
        
        // If we reached the endWord, return the distance
        if (currIdx == endIndex) {
            free(queueIdx);
            free(queueDist);
            free(visited);
            return currDist;
        }
        
        // Find all unvisited adjacent words in the wordList
        for (int i = 0; i < wordListSize; i++) {
            if (!visited[i] && isAdjacent(currWord, wordList[i], wordLen)) {
                visited[i] = true;
                queueIdx[tail] = i;
                queueDist[tail] = currDist + 1;
                tail++;
            }
        }
    }
    
    // Clean up memory if no path is found
    free(queueIdx);
    free(queueDist);
    free(visited);
    
    return 0;
}
