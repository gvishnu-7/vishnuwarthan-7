#include <stdlib.h>
#include <string.h>

int* shortestToChar(char* s, char c, int* returnSize) {
    int len = strlen(s);
    *returnSize = len;
    
    int* ans = (int*)malloc(len * sizeof(int));

    // First pass: Left to Right
    int prev = -100000;
    for (int i = 0; i < len; i++) {
        if (s[i] == c) {
            prev = i;
        }
        ans[i] = i - prev;
    }
    
    // Reset prev for the Right to Left pass
    prev = 100000;
    for (int i = len - 1; i >= 0; i--) {
        if (s[i] == c) {
            prev = i;
        }
        int dist = prev - i;
        if (dist < ans[i]) {
            ans[i] = dist;
        }
    }
