#include <stdbool.h>

// Helper function to calculate the sum of the squares of the digits of n
int getNext(int n) {
    int sum = 0;
    while (n > 0) {
        int digit = n % 10;
        sum += digit * digit;
        n /= 10;
    }
    return sum;
}

bool isHappy(int n) {
    int slow = n;
    int fast = getNext(n);

    // Loop until the fast pointer reaches 1 or catches up to the slow pointer
    while (fast != 1 && slow != fast) {
        slow = getNext(slow);         // Moves 1 step
        fast = getNext(getNext(fast)); // Moves 2 steps
    }

    // If fast reached 1, it's a happy number
    return fast == 1;
}

