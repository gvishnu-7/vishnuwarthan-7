#include <stdio.h>
#include <stdlib.h>
#include <string.h>

// Function to find the longest common prefix
char* longestCommonPrefix(char** strs, int strsSize) {
    // Handle edge case where array is empty
    if (strsSize == 0) {
        char* empty = (char*)malloc(1 * sizeof(char));
        empty[0] = '\0';
        return empty;
    }

    // Use the first string as the initial baseline prefix
    char* base = strs[0];
    int len = 0;

    // Loop through characters of the baseline string
    while (base[len] != '\0') {
        // Compare current character with all other strings
        for (int i = 1; i < strsSize; i++) {
            // If out of bounds or characters don't match, prefix ends here
            if (strs[i][len] == '\0' || strs[i][len] != base[len]) {
                goto end_search;
            }
        }
        len++;
    }

end_search:;
    // Allocate memory for the result (+1 for null terminator)
    char* result = (char*)malloc((len + 1) * sizeof(char));
    strncpy(result, base, len);
    result[len] = '\0'; // Null-terminate the string

    return result;
}
